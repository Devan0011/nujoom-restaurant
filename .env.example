# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Connection
# Get these from your Supabase project settings (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-optional

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars
JWT_EXPIRE=7d

# Admin Credentials
ADMIN_EMAIL=admin@nujoombiriyani.com
ADMIN_PASSWORD=ChangeThisPassword123!

# WhatsApp Integration
WHATSAPP_NUMBER=919876543210

# Restaurant Contact Information
RESTAURANT_PHONE=0491-252-1234
RESTAURANT_ADDRESS=Main Road, Near Clock Tower, Palakkad, Kerala 678001

# Optional Security Tokens
SEED_TOKEN=change_me_for_production_seed_endpoint
ADMIN_SETUP_TOKEN=change_me_to_enable_admin_registration_endpoint
